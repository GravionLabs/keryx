{
  "name": "@gravionlabs/keryx",
  "version": "0.1.0",
  "description": "Local event bus, Attention API and PR gates for Claude Code and OpenCode sessions",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "keryx": "dist/cli.js"
  },
  "files": [
    "dist/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GravionLabs/keryx.git",
    "directory": "packages/keryx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "schema": "tsx src/events/export-schema.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.23.15"
  }
}
